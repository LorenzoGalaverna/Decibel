<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.bluetooth</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Release builds are ad-hoc signed rather than signed with a Developer
	     ID. The hardened runtime turns on library validation, which requires
	     the app and its embedded frameworks to share a Team ID; ad-hoc
	     signatures have none, so Sparkle.framework fails to load and macOS
	     kills the app at launch. Apple permits this entitlement in notarized
	     builds, so it does not block moving to a Developer ID later - at which
	     point this key can be removed, because both will share a Team ID. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
